---
/**
 * src/pages/proto/3.astro — прототип визуального направления «Soft Sunlight».
 *
 * Что делает: показывает те же секции главной страницы конференции, что и
 * вариант 1, но в тёплой бумажно-песочной подаче: мягкие скругления, янтарный
 * акцент, спокойный синий, солнечные лучи и парящая Three.js-сцена.
 *
 * Как работает: весь текст берётся из датафайлов (`src/data`), оформление — из
 * токенов темы `theme-sunlight`. 3D-декор подключается только здесь через
 * `FloatingScene`; анимации появления — через `data-reveal` из BaseLayout.
 *
 * Статус: служебный прототип для выбора направления, помечен noindex. После
 * выбора направления секции выносятся в переиспользуемые компоненты.
 *
 * Связан с: `src/layouts/BaseLayout.astro`, `src/styles/themes/sunlight.css`,
 * `src/components/decor/FloatingScene.astro`, `src/data/*`,
 * `src/components/common/Container.astro`.
 */
import { Image } from 'astro:assets';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/common/Container.astro';
import FloatingScene from '~/components/decor/FloatingScene.astro';
import { getContent } from '~/data';
import { getPortrait } from '~/data/people';
import { withBase } from '~/i18n';
import '~/styles/themes/sunlight.css';

const c = getContent('ru');

/** Спецификация события в hero: короткие пары «подпись — значение». */
const heroSpecs = [
  { label: 'Даты', value: c.event.dateLabel },
  { label: 'Место', value: `${c.event.city}, ${c.event.country}` },
  { label: 'Формат', value: c.event.format },
  { label: 'Языки', value: c.event.languages.join(' · ') },
];

/** В прототипе показываем шесть спикеров — этого достаточно для оценки блока. */
const shownSpeakers = c.speakers.filter((s) => !s.pending).slice(0, 6);
const pendingSpeakers = c.speakers.filter((s) => s.pending).length;
---

<BaseLayout
  title={`${c.hero.title} — вариант 3, Soft Sunlight`}
  theme="theme-sunlight"
  noindex
>
  <!-- ШАПКА: мягкая sticky-капсула с blur и скруглённой кнопкой -->
  <header class="sticky top-0 z-50">
    <Container class="py-3">
      <div
        class="flex h-14 items-center justify-between gap-4 rounded-pill border border-line bg-bg/75 px-4 shadow-[0_0.75rem_2rem_color-mix(in_oklab,var(--color-ink)_6%,transparent)] backdrop-blur-md sm:px-6"
      >
        <a href={withBase('/proto/3')} class="flex items-center gap-3" aria-label={c.hero.title}>
          <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="color-mix(in oklab, var(--color-accent) 18%, transparent)"></circle>
            <path
              d="M10 22 L16 10 L23 18 M10 22 L23 18"
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <circle cx="10" cy="22" r="2.2" fill="var(--color-accent-2)"></circle>
            <circle cx="16" cy="10" r="2.2" fill="var(--color-accent)"></circle>
            <circle cx="23" cy="18" r="2.2" fill="var(--color-ink)"></circle>
          </svg>
          <span class="font-display text-sm font-semibold tracking-tight">
            Социальный капитал<span class="text-ink-3"> / 2026</span>
          </span>
        </a>

        <nav class="hidden items-center gap-6 lg:flex" aria-label="Основная навигация">
          {
            c.nav.map((item) => (
              <a
                href={item.href}
                class="text-sm text-ink-2 transition-colors duration-200 hover:text-accent"
              >
                {item.label}
                {item.pending && <span class="ml-1 align-super text-[0.6rem] text-ink-3">•</span>}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-3 sm:gap-4">
          <a href={withBase('/en')} class="text-sm text-ink-3 transition-colors hover:text-ink">EN</a>
          <a
            href="#registration"
            class="rounded-control bg-accent px-4 py-2 text-sm font-medium text-on-accent shadow-[0_0.5rem_1.25rem_color-mix(in_oklab,var(--color-accent)_28%,transparent)] transition-transform duration-200 hover:-translate-y-0.5"
          >
            Регистрация
          </a>
        </div>
      </div>
    </Container>
  </header>

  <main id="main">
    <!-- HERO: тёплый заголовок слева, 3D-сцена и лучи справа -->
    <section class="relative overflow-hidden">
      <div class="decor-sunrays" aria-hidden="true"></div>
      <span class="decor-sun-gleam -left-16 top-8 opacity-80" aria-hidden="true"></span>
      <span class="decor-dust left-[18%] top-[22%] size-1.5" style="animation-delay: -2s" aria-hidden="true"></span>
      <span class="decor-dust left-[42%] top-[38%] size-1" style="animation-delay: -5s" aria-hidden="true"></span>
      <span class="decor-bubble right-[28%] top-[30%] size-3" style="animation-delay: -1s" aria-hidden="true"></span>
      <span class="decor-bubble right-[12%] top-[48%] size-2" style="animation-delay: -4s" aria-hidden="true"></span>

      <Container class="relative grid items-center gap-10 pt-10 pb-16 lg:grid-cols-12 lg:gap-8 lg:pt-16 lg:pb-24">
        <div class="lg:col-span-6 xl:col-span-5">
          <p class="eyebrow text-accent" data-reveal>{c.hero.eyebrow}</p>

          <h1
            class="mt-6 font-display text-display font-semibold text-ink"
            data-reveal
            data-reveal-delay="80"
          >
            {
              c.hero.titleLines.map((line, i) => (
                <span class="block">
                  {i === c.hero.titleLines.length - 1 ? <span class="text-accent">{line}</span> : line}
                </span>
              ))
            }
          </h1>

          <p class="mt-7 max-w-xl text-lead text-ink-2" data-reveal data-reveal-delay="140">
            {c.hero.lead}
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="200">
            <a
              href={c.hero.primaryCta.href}
              class="inline-flex items-center gap-2 rounded-control bg-accent px-6 py-3.5 font-medium text-on-accent shadow-[0_0.75rem_1.75rem_color-mix(in_oklab,var(--color-accent)_30%,transparent)] transition-transform duration-200 hover:-translate-y-0.5"
            >
              {c.hero.primaryCta.label}
              <span aria-hidden="true">→</span>
            </a>
            <a
              href={c.hero.secondaryCta.href}
              class="inline-flex items-center gap-2 rounded-control border border-line-strong bg-surface/70 px-6 py-3.5 font-medium text-ink transition-colors duration-200 hover:bg-surface"
            >
              {c.hero.secondaryCta.label}
            </a>
          </div>

          <dl
            class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4"
            data-reveal
            data-reveal-delay="260"
          >
            {
              heroSpecs.map((spec) => (
                <div class="soft-card px-4 py-3">
                  <dt class="text-xs text-ink-3">{spec.label}</dt>
                  <dd class="mt-1 font-display text-sm font-semibold">{spec.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="relative lg:col-span-6 xl:col-span-7" data-reveal data-reveal-delay="120">
          <FloatingScene class="mx-auto h-[22rem] w-full max-w-xl sm:h-[26rem] lg:h-[32rem] lg:max-w-none" />
        </div>
      </Container>
    </section>

    <!-- ЧТО ДАЁТ УЧАСТИЕ: шесть мягких карточек с воздухом -->
    <section id="about" class="relative overflow-hidden">
      <span class="decor-sun-gleam -right-20 top-10 opacity-60" aria-hidden="true"></span>
      <Container class="relative py-16 lg:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-accent">01</p>
          <h2 class="mt-3 font-display text-headline font-semibold">{c.sectionTitles.keyFacts}</h2>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            c.keyFacts.map((fact, i) => (
              <article
                class="soft-card group p-7 transition-transform duration-300 hover:-translate-y-1"
                data-reveal
                data-reveal-delay={i * 70}
              >
                <span class="inline-flex size-9 items-center justify-center rounded-pill bg-bg-alt font-mono text-sm text-accent">
                  0{i + 1}
                </span>
                <h3 class="mt-5 font-display text-title font-semibold">{fact.title}</h3>
                <p class="mt-3 text-ink-2">{fact.body}</p>
                {fact.link && (
                  <a
                    href={fact.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-ink"
                  >
                    {fact.link.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- ТЕМЫ: мягкие нумерованные плитки -->
    <section id="topics" class="bg-bg-alt">
      <Container class="py-16 lg:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-accent">02</p>
          <h2 class="mt-3 font-display text-headline font-semibold">{c.sectionTitles.topics}</h2>
        </div>

        <ol class="mt-12 grid gap-4 md:grid-cols-2">
          {
            c.topics.items.map((topic, i) => (
              <li data-reveal data-reveal-delay={i * 60}>
                <a
                  href="#registration"
                  class="soft-card group flex items-center gap-5 p-6 transition-transform duration-300 hover:-translate-y-0.5"
                >
                  <span class="flex size-12 shrink-0 items-center justify-center rounded-pill bg-bg-alt font-mono text-sm text-accent-2">
                    {topic.index}
                  </span>
                  <span class="font-display text-title font-medium transition-colors duration-200 group-hover:text-accent">
                    {topic.title}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>

        <p class="mt-10 max-w-xl text-ink-2">{c.topics.note}</p>
      </Container>
    </section>

    <!-- КЛЮЧЕВЫЕ ДАТЫ: тёплый таймлайн без резких углов -->
    <section class="section-warm relative overflow-hidden">
      <span class="decor-dust left-[10%] top-[20%] size-1.5" style="animation-delay: -3s" aria-hidden="true"></span>
      <span class="decor-bubble right-[15%] bottom-[18%] size-2.5" style="animation-delay: -6s" aria-hidden="true"></span>
      <Container class="relative py-16 lg:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-accent">03</p>
          <h2 class="mt-3 font-display text-headline font-semibold">{c.sectionTitles.deadlines}</h2>
        </div>

        <ol class="mt-12 grid gap-4 md:grid-cols-3 lg:grid-cols-5">
          {
            c.deadlines.map((d, i) => (
              <li
                class:list={[
                  'soft-card relative p-6',
                  d.highlight && 'ring-2 ring-accent/40',
                ]}
                data-reveal
                data-reveal-delay={i * 80}
              >
                <div class="flex items-center gap-3">
                  <span
                    class:list={[
                      'size-2.5 shrink-0 rounded-pill',
                      d.highlight ? 'bg-accent' : 'bg-accent-2/50',
                    ]}
                    aria-hidden="true"
                  ></span>
                  <time datetime={d.dateISO} class="font-mono text-xs text-ink-2">
                    {d.dateLabel}
                  </time>
                </div>
                <h3
                  class:list={[
                    'mt-4 font-display text-title font-semibold',
                    d.highlight && 'text-accent',
                  ]}
                >
                  {d.title}
                </h3>
                {d.note && <p class="mt-2 text-sm text-ink-2">{d.note}</p>}
              </li>
            ))
          }
        </ol>
      </Container>
    </section>

    <!-- СПИКЕРЫ: тёплые скруглённые портреты без grayscale -->
    <section id="speakers">
      <Container class="py-16 lg:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-accent">04</p>
          <h2 class="mt-3 font-display text-headline font-semibold">{c.sectionTitles.speakers}</h2>
        </div>

        <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {
            shownSpeakers.map((person, i) => {
              const portrait = getPortrait(person.photoKey);
              return (
                <li class="group" data-reveal data-reveal-delay={i * 70}>
                  {portrait && (
                    <div class="overflow-hidden rounded-card bg-surface-2 shadow-[0_1rem_2rem_color-mix(in_oklab,var(--color-ink)_7%,transparent)]">
                      <Image
                        src={portrait}
                        alt={person.name}
                        width={520}
                        height={620}
                        widths={[320, 520, 780]}
                        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 30vw"
                        class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <h3 class="mt-5 font-display text-title font-semibold">{person.name}</h3>
                  <p class="mt-2 text-sm text-ink-2">{person.role}</p>
                  <p class="mt-3 text-xs tracking-wide text-ink-3 uppercase">{person.country}</p>
                </li>
              );
            })
          }
        </ul>

        {
          pendingSpeakers > 0 && (
            <p class="mt-12 rounded-card bg-bg-alt px-6 py-4 text-sm text-ink-3">
              Список спикеров пополняется — на согласовании ещё {pendingSpeakers}.
            </p>
          )
        }
      </Container>
    </section>

    <!-- ВРЕМЯ И ЯЗЫКИ: мягкая таблица / стек на мобильном -->
    <section class="bg-bg-alt">
      <Container class="py-16 lg:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-accent">05</p>
          <h2 class="mt-3 font-display text-headline font-semibold">{c.sectionTitles.schedule}</h2>
        </div>

        <p class="mt-6 max-w-2xl text-ink-2">{c.schedule.note}</p>

        <div class="soft-card mt-10 overflow-hidden">
          <table class="hidden w-full border-collapse text-left sm:table">
            <thead>
              <tr class="border-b border-line bg-surface-2/60">
                <th class="px-6 py-4 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
                  {c.schedule.columns.city}
                </th>
                <th class="px-4 py-4 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
                  UTC
                </th>
                <th class="px-4 py-4 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
                  {c.schedule.columns.start}
                </th>
                <th class="px-6 py-4 font-mono text-xs font-medium tracking-wider text-ink-3 uppercase">
                  {c.schedule.columns.end}
                </th>
              </tr>
            </thead>
            <tbody>
              {
                c.schedule.rows.map((row) => (
                  <tr class="border-b border-line last:border-b-0">
                    <td
                      class:list={[
                        'px-6 py-4 font-display font-medium',
                        row.primary && 'text-accent',
                      ]}
                    >
                      {row.city}
                    </td>
                    <td class="px-4 py-4 font-mono text-sm text-ink-3">{row.utc}</td>
                    <td class="px-4 py-4 font-mono">{row.start}</td>
                    <td class="px-6 py-4 font-mono">{row.end}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <ul class="sm:hidden">
            {
              c.schedule.rows.map((row) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-line px-5 py-4 last:border-b-0">
                  <div>
                    <p class:list={['font-display font-medium', row.primary && 'text-accent']}>
                      {row.city}
                    </p>
                    <p class="font-mono text-xs text-ink-3">{row.utc}</p>
                  </div>
                  <p class="font-mono text-sm">
                    {row.start} — {row.end}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <p class="mt-8 text-sm text-ink-3">
          {c.schedule.languagesLabel}: <span class="text-ink">{c.event.languages.join(', ')}</span>
        </p>
      </Container>
    </section>

    <!-- ФИНАЛЬНЫЙ CTA: тёплое солнечное пятно и мягкая кнопка -->
    <section id="registration" class="section-warm relative overflow-hidden">
      <div class="decor-sunrays opacity-70" aria-hidden="true"></div>
      <Container class="relative py-20 lg:py-28">
        <div class="soft-card mx-auto max-w-4xl px-8 py-12 text-center sm:px-12 lg:py-16">
          <p class="eyebrow text-accent" data-reveal>{c.sectionTitles.registration}</p>
          <h2
            class="mx-auto mt-5 max-w-2xl font-display text-headline font-semibold"
            data-reveal
            data-reveal-delay="80"
          >
            Доверие, репутация и связи — измеримый ресурс. Приезжайте разбираться вместе.
          </h2>
          <div class="mt-9" data-reveal data-reveal-delay="160">
            <a
              href="#registration"
              class="inline-flex items-center gap-3 rounded-control bg-accent px-8 py-4 font-medium text-on-accent shadow-[0_1rem_2.5rem_color-mix(in_oklab,var(--color-accent)_32%,transparent)] transition-transform duration-200 hover:-translate-y-0.5"
            >
              {c.registration.title}
              <span aria-hidden="true">→</span>
            </a>
            <p class="mx-auto mt-5 max-w-md text-sm text-ink-2">{c.registration.lead}</p>
          </div>
        </div>
      </Container>
    </section>

    <!-- ПОДВАЛ -->
    <footer id="contacts" class="bg-bg">
      <Container class="grid gap-x-12 gap-y-10 py-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="max-w-sm text-sm text-ink-2">{c.footer.note}</p>
          <p class="mt-4 text-xs text-ink-3">{c.footer.imagesNote}</p>
        </div>

        <div class="lg:col-span-4">
          <h3 class="eyebrow text-ink-3">{c.sectionTitles.contacts}</h3>
          <ul class="mt-4 space-y-3 text-sm">
            {
              c.contacts[0]?.people.map((p) => (
                <li class="soft-card px-4 py-3">
                  <span class="block font-medium">{p.name}</span>
                  {p.email && (
                    <a href={`mailto:${p.email}`} class="text-ink-2 transition-colors hover:text-accent">
                      {p.email}
                    </a>
                  )}
                  {p.phone && <span class="block text-ink-2">{p.phone}</span>}
                </li>
              ))
            }
          </ul>
        </div>

        <nav class="lg:col-span-3" aria-label="Ссылки организаторов">
          <h3 class="eyebrow text-ink-3">Организаторы</h3>
          <ul class="mt-4 space-y-2 text-sm">
            {
              c.footer.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ink-2 transition-colors hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </Container>

      <Container class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-xs text-ink-3">
        <span>© 2026 УрФУ · Уральский институт управления РАНХиГС</span>
        <a
          href={c.footer.designCredit.href}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-accent"
        >
          {c.footer.designCredit.label}
        </a>
        <a href={withBase('/')} class="transition-colors hover:text-accent">← Все варианты дизайна</a>
      </Container>
    </footer>
  </main>
</BaseLayout>
