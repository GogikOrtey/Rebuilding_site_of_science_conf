---
/**
 * src/components/decor/SocialGraph.astro — живой граф связей для темы navy.
 *
 * Что делает: рисует на `<canvas>` дрейфующие узлы и линии между близкими
 * точками — визуальная метафора измеримого социального капитала. Линии тем
 * ярче, чем ближе узлы друг к другу.
 *
 * Как работает: чистый Canvas 2D без библиотек. Цвета читаются из CSS-токенов
 * темы (`--color-accent-2`, `--color-accent`, `--color-line`) через
 * `getComputedStyle`. Анимация крутится через `requestAnimationFrame`,
 * учитывает `devicePixelRatio`, паузится вне вьюпорта (IntersectionObserver)
 * и при `prefers-reduced-motion` (один статичный кадр). Размер синхронизируется
 * через ResizeObserver.
 *
 * Связан с: `src/styles/themes/navy.css` (токены и `.decor-grid`),
 * `src/pages/proto/2.astro` (размещение в hero).
 */
export interface Props {
  /** Дополнительные классы на обёртку (позиция/размер в hero). */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={['social-graph pointer-events-none absolute inset-0', className]}
  data-social-graph
  aria-hidden="true"
>
  <canvas class="block size-full" aria-hidden="true"></canvas>
</div>

<script>
  /**
   * Узел графа: позиция, скорость и радиус точки.
   * Используется только внутри анимации SocialGraph.
   */
  type GraphNode = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
  };

  /**
   * Читает цвет токена темы с элемента (или body) через computed styles.
   * Нужно, чтобы canvas совпадал с палитрой `.theme-navy` без хардкодов.
   */
  function readToken(el: Element, name: string, fallback: string): string {
    const value = getComputedStyle(el).getPropertyValue(name).trim();
    return value || fallback;
  }

  /** Кэш разобранных RGB, чтобы не трогать DOM на каждом кадре. */
  const rgbCache = new Map<string, [number, number, number]>();

  /**
   * Разбирает CSS-цвет в RGB через одноразовый probe-элемент.
   * Результат кэшируется; используется для полупрозрачных линий графа.
   */
  function toRgb(color: string): [number, number, number] {
    const cached = rgbCache.get(color);
    if (cached) return cached;

    const probe = document.createElement('div');
    probe.style.color = color;
    document.body.appendChild(probe);
    const computed = getComputedStyle(probe).color;
    probe.remove();

    const match = computed.match(/rgba?\(([^)]+)\)/);
    const fallback: [number, number, number] = [63, 223, 192];
    if (!match) {
      rgbCache.set(color, fallback);
      return fallback;
    }

    const parts = match[1].split(',').map((p) => Number.parseFloat(p.trim()));
    const rgb: [number, number, number] = [parts[0] ?? 0, parts[1] ?? 0, parts[2] ?? 0];
    rgbCache.set(color, rgb);
    return rgb;
  }

  /**
   * Переводит CSS-цвет в rgba с заданной прозрачностью.
   * Нужно для линий разной яркости при сближении узлов.
   */
  function withAlpha(color: string, alpha: number): string {
    const [r, g, b] = toRgb(color);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  /**
   * Запускает анимацию графа на одном корневом элементе `[data-social-graph]`.
   * Вызывается при инициализации страницы для каждого островка.
   */
  function mountGraph(root: HTMLElement): void {
    const canvasEl = root.querySelector('canvas');
    if (!(canvasEl instanceof HTMLCanvasElement)) return;

    const context = canvasEl.getContext('2d');
    if (!context) return;

    // Явные алиасы: TS иначе теряет сужение типов внутри вложенных функций.
    const canvas: HTMLCanvasElement = canvasEl;
    const ctx: CanvasRenderingContext2D = context;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const linkDistance = 140;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let nodes: GraphNode[] = [];
    let rafId = 0;
    let visible = true;
    let running = false;

    /**
     * Создаёт набор узлов со случайными позициями и малыми скоростями.
     * Пересоздаётся при заметном изменении размера canvas.
     */
    function seedNodes(count: number): GraphNode[] {
      const list: GraphNode[] = [];
      for (let i = 0; i < count; i += 1) {
        list.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.35,
          r: 1.4 + Math.random() * 1.8,
        });
      }
      return list;
    }

    /**
     * Подгоняет буфер canvas под CSS-размер и devicePixelRatio.
     * Вызывается из ResizeObserver и при первом старте.
     */
    function resize(): void {
      const rect = root.getBoundingClientRect();
      width = Math.max(1, Math.floor(rect.width));
      height = Math.max(1, Math.floor(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const targetCount = Math.max(18, Math.min(42, Math.round((width * height) / 18000)));
      if (nodes.length === 0 || Math.abs(nodes.length - targetCount) > 6) {
        nodes = seedNodes(targetCount);
      } else {
        for (const node of nodes) {
          node.x = Math.min(width, Math.max(0, node.x));
          node.y = Math.min(height, Math.max(0, node.y));
        }
      }
    }

    /**
     * Рисует один кадр: связи между близкими узлами и сами точки.
     * Цвета берутся из токенов темы на каждом кадре (на случай смены темы).
     */
    function draw(): void {
      const accent2 = readToken(root, '--color-accent-2', '#3fdfc0');
      const accent = readToken(root, '--color-accent', '#f5c451');
      const line = readToken(root, '--color-line', '#1e2f5e');

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < nodes.length; i += 1) {
        for (let j = i + 1; j < nodes.length; j += 1) {
          const a = nodes[i];
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist > linkDistance) continue;

          const t = 1 - dist / linkDistance;
          const strength = t * t;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = withAlpha(accent2, 0.08 + strength * 0.55);
          ctx.lineWidth = 0.6 + strength * 1.2;
          ctx.stroke();

          if (strength > 0.72) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = withAlpha(accent, 0.12 + strength * 0.25);
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      for (const node of nodes) {
        ctx.beginPath();
        ctx.arc(node.x, node.y, node.r + 3, 0, Math.PI * 2);
        ctx.fillStyle = withAlpha(accent2, 0.12);
        ctx.fill();

        ctx.beginPath();
        ctx.arc(node.x, node.y, node.r, 0, Math.PI * 2);
        ctx.fillStyle = accent2;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(node.x, node.y, Math.max(0.8, node.r * 0.35), 0, Math.PI * 2);
        ctx.fillStyle = withAlpha(line, 0.35);
        ctx.fill();
      }
    }

    /**
     * Сдвигает узлы на один шаг с отражением от краёв.
     * Вызывается только когда анимация активна.
     */
    function step(): void {
      for (const node of nodes) {
        node.x += node.vx;
        node.y += node.vy;

        if (node.x < 0 || node.x > width) {
          node.vx *= -1;
          node.x = Math.min(width, Math.max(0, node.x));
        }
        if (node.y < 0 || node.y > height) {
          node.vy *= -1;
          node.y = Math.min(height, Math.max(0, node.y));
        }
      }
    }

    /**
     * Цикл анимации: шаг → отрисовка → следующий кадр.
     * Останавливается, когда граф вне вьюпорта или reduced-motion.
     */
    function tick(): void {
      if (!running) return;
      step();
      draw();
      rafId = window.requestAnimationFrame(tick);
    }

    /** Запускает цикл, если ещё не запущен. */
    function start(): void {
      if (running || reducedMotion || !visible) return;
      running = true;
      rafId = window.requestAnimationFrame(tick);
    }

    /** Останавливает цикл без очистки текущего кадра. */
    function stop(): void {
      running = false;
      if (rafId) {
        window.cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }

    resize();
    draw();

    if (reducedMotion) return;

    const resizeObserver = new ResizeObserver(() => {
      resize();
      draw();
    });
    resizeObserver.observe(root);

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (visible) start();
        else stop();
      },
      { threshold: 0.05 },
    );
    io.observe(root);

    document.addEventListener(
      'visibilitychange',
      () => {
        if (document.hidden) stop();
        else if (visible) start();
      },
      { passive: true },
    );
  }

  /**
   * Инициализирует все графы на странице.
   * Astro-скрипт компонента выполняется один раз и обрабатывает все инстансы.
   */
  function initSocialGraphs(): void {
    document.querySelectorAll<HTMLElement>('[data-social-graph]').forEach(mountGraph);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSocialGraphs, { once: true });
  } else {
    initSocialGraphs();
  }
</script>
